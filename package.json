{
    "name": "matlab-azure-devops-extension",
    "version": "1.0.0",
    "scripts": {
        "bat": "npm run clean && npm run build && npm run test",
        "clean": "node ./scripts/clean.js",
        "lint": "eslint 'tasks/**/*.ts'",
        "compile": "node ./scripts/compile.js",
        "copyResources": "node ./scripts/copyResources.js",
        "build": "npm run lint && npm run compile && npm run copyResources",
        "test": "node ./scripts/test.js",
        "preparePackage": "node ./scripts/preparePackage.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.7.5",
        "@types/shelljs": "^0.8.15",
        "@types/sinon": "^10.0.13",
        "@types/uuid": "^9.0.8",
        "mocha": "^11.8.0",
        "nyc": "^17.1.0",
        "shelljs": "^0.8.5",
        "sinon": "^15.0.1",
        "tfx-cli": "^0.23.4",
        "@eslint/js": "^9.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "typescript": "^5.5.0"
    },
    "nyc": {
        "exclude": "**/test/*"
    }
}
